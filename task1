function hasTwoCubeSums(n) {
  let count = 0;
  let limit = Math.floor(Math.cbrt(n)); 
  
  for (let a = 1; a <= limit; a++) {
    for (let b = a + 1; b <= limit; b++) {
      let sum = Math.pow(a, 3) + Math.pow(b, 3);
      
      if (sum === n) {
        count++;
      }
      
      if (count === 2) {
        return true;
      }
    }
  }
  
  return false;
}
